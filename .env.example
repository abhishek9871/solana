# Bot mode is deliberately limited to paper or testnet.
# paper = simulated trades using public Binance market data.
# testnet = virtual Spot Testnet orders using Binance testnet keys.
BOT_MODE=paper

SYMBOL=BTCUSDT
INTERVAL=5m
CANDLE_LIMIT=150
POLL_SECONDS=60

# Strategy settings. These are educational defaults, not a profit promise.
FAST_EMA=12
SLOW_EMA=26
RSI_PERIOD=14
ATR_PERIOD=14
RSI_BUY_CEILING=68
STOP_LOSS_PCT=0.0075
TAKE_PROFIT_PCT=0.012
TRAILING_STOP_PCT=0.006

# Risk settings.
STARTING_QUOTE=1000
POSITION_FRACTION=0.10
MAX_TRADE_QUOTE=50
MIN_TRADE_QUOTE=10
MAX_DAILY_LOSS_QUOTE=15
FEE_BPS=10

# Only required for BOT_MODE=testnet.
# Create testnet keys at https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Only required for explicit Binance USD-M futures live scripts.
# Keep withdrawals disabled on the API key.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_LIVE_CONFIRM=

# Forced-edge scanner. Read-only by default; no private key is used.
# Multiple Base RPCs can be comma-separated for failover.
BASE_RPC_URL=https://base-rpc.publicnode.com,https://base.llamarpc.com,https://mainnet.base.org,https://1rpc.io/base
FORCED_EDGE_CAPITAL_USD=28
FORCED_EDGE_MIN_NET_USD=0.03
FORCED_EDGE_SAFETY_USD=0.05
FORCED_EDGE_POLL_SECONDS=30
COMPOUND_LOOKBACK_BLOCKS=1800
COMPOUND_LOG_CHUNK_BLOCKS=600
COMPOUND_MAX_ACCOUNTS=60
COMPOUND_ACCOUNT_TIME_BUDGET_SEC=25
BINANCE_SPOT_TAKER_FEE=0.001
BINANCE_FUTURES_TAKER_FEE=0.0005
TRIANGULAR_TOP_CANDIDATES=8
POLYMARKET_MARKET_LIMIT=40
POLYMARKET_TAKER_FEE=0.001

# Prediction hunter bot. Dry-run is the default and should stay enabled until
# credentials, funding, and legal access are confirmed.
POLYMARKET_DRY_RUN=1
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_MAX_CAPITAL_USD=20
PREDICTION_HUNTER_POLL_SECONDS=20
PREDICTION_ENABLE_REWARD=1
PREDICTION_REWARD_MARKETS=1
PREDICTION_MIN_REWARD_DAY=3
PREDICTION_MAX_MIN_SIZE=28
PREDICTION_MAX_PAIR_COST=0.995
PREDICTION_QUOTE_OFFSET_TICKS=0
PREDICTION_AVOID_KEYWORDS=war,death,assassination,terror,shooting,invasion,missile
PREDICTION_ENABLE_CRYPTO_LIVE=0
PREDICTION_CRYPTO_MARKETS=2
PREDICTION_CRYPTO_CAPITAL_USD=8
PREDICTION_CRYPTO_QUOTE_SIZE=5
PREDICTION_CRYPTO_MAX_PAIR_COST=0.99
PREDICTION_EVENT_WATCH_ITEMS=5
