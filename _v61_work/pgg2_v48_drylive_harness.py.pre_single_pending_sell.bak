                f"pbs1000={_v56d_buy_sol_1000:.3f} min_pbs1000={_v56d_min_buy_sol_1000:.3f} "
                f"psc1000={_v56d_sell_count_1000} max_psc1000={_v56d_max_sell_count_1000} "
