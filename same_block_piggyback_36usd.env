# Same Block Piggyback Bot - $36 bankroll guard profile
# Load this before running live/quote mode. Keep paper mode until replay stats pass.

PGG2_EXECUTION_MODE=paper
PIGGY_PAPER_TRADING=true
PGG2_ENABLE_LIVE=false

# Set the true SOL value of the Phantom trading wallet. At SOL ~= $88.52, $36 ~= 0.40 SOL.
PGG2_BANKROLL_SOL=0.40

# Keep frequency high, but cap single-rug damage. Overrides are optional because
# same_block_piggyback_corrected.py computes similar defaults from PGG2_BANKROLL_SOL.
PIGGY_SCOUT_SOL=0.006
PIGGY_MAX_POSITION_SOL=0.040
PIGGY_MAX_OPEN_POSITIONS=2
PIGGY_MAX_PENDING_STRIKES=3
PIGGY_MIN_SECONDS_BETWEEN_STRIKES=0.04

# Enable layered confirmation before full-size scaling.
PGG2_LAYERED_RISK_ENABLED=true
PGG2_LAYERED_ENTRY_FRACTION=0.55
PGG2_LAYERED_SCALE_MIN_POST_BUY_SOL=0.25
PGG2_LAYERED_SCALE_MIN_POST_BUY_COUNT=2

# Make weak post-entry follow-through close quickly rather than becoming a full rug.
PIGGY_NO_FOLLOW_CAP_ON=true
PIGGY_NO_FOLLOW_CAP_AFTER_SEC=4.5
PIGGY_NO_FOLLOW_CAP_UNTIL_SEC=18.0
PIGGY_NO_FOLLOW_CAP_MIN_SIG_BUY_SOL=0.10
PIGGY_NO_FOLLOW_CAP_MULT=0.985

# Keep dangerous experimental lanes tiny unless replay proves them.
PGG2_STEALTH_ARM_ENABLED=false
PGG2_SPARK3_ARM_ENABLED=false
PGG2_SPARK3_ARM_SHADOW_ONLY=true
PGG2_BREADTH_SCALE_ENABLED=false
PGG2_BIRTH_FANOUT_SCALE_ENABLED=false
PGG2_SPARK3_ARM_SCALE_ENABLED=false
PGG2_SPARK3_BREAKOUT_SCALE_ENABLED=false

# Never use transaction price hints for real PnL; rely on bonding-curve reserves.
PGG2_USE_PRICE_HINTS=false
